# macOS
.DS_Store

# 密钥/本地配置(不要提交)
.env

# Python
__pycache__/
*.pyc

# Jetbrains
.idea

# ============================================================
# resume / interview 目录为个人隐私，不进入git管理，如有需要，自行放行
# ============================================================

# 忽略 resume 下全部内容
resume/**/*

# 不忽略：以 底稿.md 结尾的md文件
!resume/**/*底稿.md


# 先忽略 interview 目录下全部内容
interview/*

# 不忽略 interview 下直接的md文件（一级，不会递归子目录）
!interview/*.md
