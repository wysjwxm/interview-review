# ============================================================
# 语音识别 API 配置示例
# 使用步骤:复制本文件为 .env,填好你的 key;.env 不要提交(已在 .gitignore)。
# 换服务只需改下面三个变量,脚本 transcribe.py 无需改动。
# ============================================================

# --- 方案一:Groq(whisper-large-v3-turbo,邮箱注册、免信用卡;大陆可能需代理) ---
# ASR_BASE_URL=https://api.groq.com/openai/v1
# ASR_API_KEY=在这里填你的_key
# ASR_MODEL=whisper-large-v3-turbo
# ASR_LANGUAGE=zh        # 可选,显式指定语言

# --- 方案二:SiliconFlow 硅基流动(SenseVoiceSmall,中文最强;国内直连,需实名) ---
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=在这里填你的_key
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# --- 方案三:OpenAI 官方 ---
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=在这里填你的_key
# ASR_MODEL=whisper-1
